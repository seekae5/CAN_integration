{
  "messages": ["motor_temperature", "inverter_speed", "inverter_status_3"],
  "catalog": "catalog.example.json",
  "interface": "pcan",
  "channel": "PCAN_USBBUS1",
  "bitrate": 1000000,
  "max_age": 1.0,
  "startup_timeout": 5.0,
  "limits": {
    "motor_temperature.temperature": 80.0,
    "inverter_status_3.temperature": { "max": 90.0, "action": "abort" },
    "rpm_actual": { "max": 8000, "action": "abort" },
    "u_dc": { "min": 300, "max": 420, "action": "warn" }
  },
  "safe_state": [
    { "message": "broadcast_command", "values": { "command": 0 } }
  ]
}
